# Port server Node (server.js).
# Di Railway TIDAK perlu diisi — Railway ngasih PORT otomatis.
# Buat lokal default: 3000
PORT=3000

# Opsional — API key eksternal jika ingin menambah tools berbayar nanti
# (Saat ini TIDAK dipakai; semua tools jalan tanpa key)
RAPIDAPI_KEY=
